  "structures": [
    {
      "id": "nao-e-so",
      "regex": "(?i)\\bnão (?:é )?(?:apenas|só|somente) [^.!?\\n]{2,60}[,.] (?:é|mas)\\b",
      "name": "\"Não é só X, é Y\"",
      "fix": "Diga a única coisa que você quer dizer. Apague a metade que só prepara o terreno."
    },
    {
      "id": "nao-so-mas-tambem",
      "regex": "(?i)\\bnão (?:só|apenas|somente)\\b[^.!?\\n]{2,80}\\bmas também\\b",
      "name": "\"Não só X, mas também Y\"",
      "fix": "Quebre em duas frases ou corte a metade mais fraca."
    },
    {
      "id": "nao-se-trata",
      "regex": "(?i)\\bnão (?:é sobre|se trata de) [^.!?\\n]{2,60}[.!,] (?:é sobre|se trata de|trata-se de)\\b",
      "name": "\"Não é sobre X. É sobre Y.\"",
      "fix": "Comece pelo Y. A inversão é o que denuncia."
    },
    {
      "id": "revelacao",
      "regex": "(?i)^\\s*(?:o resultado|a melhor parte|o detalhe|o problema|o segredo|a lição|o pulo do gato)\\?\\s*$",
      "name": "Pergunta retórica de uma linha só",
      "fix": "Responda na própria frase em vez de encenar uma revelação."
    },
    {
      "id": "o-que-aprendi",
      "regex": "(?i)\\b(?:aqui está|eis|veja) o que (?:eu )?(?:aprendi|aprendemos)\\b|\\bo que (?:eu )?aprendi:",
      "name": "\"Eis o que aprendi\"",
      "fix": "Diga a lição. Pule o anúncio."
    },
    {
      "id": "triade",
      "regex": "(?i)\\b\\w+, \\w+ e \\w+\\.",
      "name": "Tríade (regra de três)",
      "fix": "Dois itens ou quatro. Três é o ritmo padrão do modelo."
    },
    {
      "id": "foguete",
      "regex": "[\\U0001F680\\U0001F525\\U0001F4A1\\u2728\\U0001F3AF]",
      "name": "Emoji de foguete / fogo / lâmpada / brilho / alvo",
      "fix": "No máximo um emoji, e que não seja um desses cinco."
    },
    {
      "id": "muro-de-hashtags",
      "regex": "(?:#\\w+[ \\t]*){5,}",
      "name": "Muro de hashtags (5 ou mais)",
      "fix": "Três hashtags. O LinkedIn parou de premiar o muro."
    },
    {
      "id": "como-uma-ia",
      "regex": "(?i)\\bcomo (?:uma )?(?:ia|inteligência artificial|modelo de linguagem), (?:eu|não)\\b",
      "name": "Autorreferência do modelo",
      "fix": "Apague a frase."
    },
    {
      "id": "em-resumo",
      "regex": "(?i)^\\s*(?:em resumo|resumindo|em suma|em conclusão|concluindo)\\b",
      "name": "Abertura de conclusão de redação",
      "fix": "Post não precisa de parágrafo de conclusão."
    },
    {
      "id": "isca-de-engajamento",
      "regex": "(?i)(?:concorda\\?|concordam\\?|o que (?:você|vocês) (?:acha|acham|pensa|pensam)\\??|e você\\?|e vocês\\?|faz sentido\\?|estou errado\\?|quem mais\\b[^\\n]*\\?)\\s*$",
      "name": "Isca de engajamento automática",
      "fix": "Faça uma pergunta que só você faria, sobre o ponto específico acima dela."
    }
  ]
